# ============================================================
# FIX 4 — configurable_parser.py
# _extract_first_shipment_llm: isola la spedizione saltando i Borderò
# ============================================================

def _extract_first_shipment_llm(self, block0: str, extraction_prompt: str) -> dict:
    """
    FIX 3 — Estrae la prima spedizione dal blocco 0.
    Isola il testo della spedizione saltando i numeri Borderò che
    precedono il tracking reale nella stessa riga o blocco.
    """
    # Trova il primo tracking che NON sia preceduto da "Borderò" sulla riga prima
    relevant_text = block0[:2000]
    matches = list(re.finditer(r'\d{2}/\d{2}/\d{6}', block0))
    for m in matches:
        line_start = block0.rfind('\n', 0, m.start())
        line_before = block0[line_start:m.start()].strip()
        if re.search(r'border[oò°]', line_before, re.IGNORECASE):
            continue  # Salta i numeri Borderò
        # Trovato il tracking reale: prendi il testo da questo punto
        start = max(0, m.start() - 30)
        relevant_text = block0[start:start + 2000]
        break

    prompt = (
        extraction_prompt + "\n\n"
        "IMPORTANTE: Il testo seguente contiene dati di UNA spedizione. "
        "Ignora qualsiasi intestazione fattura, IVA, totali di fattura, dati aziendali. "
        "Estrai SOLO i dati della singola spedizione "
        "(tracking, data spedizione, mittente, destinatario, importo spedizione).\n\n"
        f"TESTO:\n{relevant_text}\n\n"
        "Restituisci un array JSON con UN solo oggetto per la spedizione trovata. Solo il JSON."
    )
    try:
        raw = self._call_ollama(prompt, timeout=60.0)
        arr_match = re.search(r"\[.*\]", raw, re.DOTALL)
        if arr_match:
            results = json.loads(arr_match.group(0))
            if isinstance(results, list) and results:
                return results[0]
        obj_match = re.search(r"\{.*\}", raw, re.DOTALL)
        if obj_match:
            return json.loads(obj_match.group(0))
    except Exception as e:
        logger.warning(f"[Parser Block0] Errore: {e}")
    return {}


