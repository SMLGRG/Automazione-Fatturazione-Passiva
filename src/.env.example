# URL del container Ollama (non modificare in sviluppo locale con Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Modello LLM da usare
OLLAMA_MODEL=qwen2.5:3b

# Path al database aziendale (SQLite in sviluppo)
DATABASE_URL=sqlite:///./app.db

# Directory per i PDF caricati
UPLOAD_DIR=./uploads

# Directory per CSV e report generati
OUTPUT_DIR=./outputs